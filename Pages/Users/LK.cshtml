@page
@model WebApplication1.Pages.Users.DetailsModel

@{
    ViewData["Title"] = "ЛК";
}

<div class="profile-container text-center">
    <div class="profile-header">
        <h1>Личный кабинет</h1>
        <hr />
    </div>

    <div class="profile-info text-center">
        <div class="row">
            <div class="col-md-12">
                <h5 class="mb-3">Пользователь: @Html.DisplayFor(model => model.Users.Username)</h5>
            </div>
        </div>
    </div>

    <div class="profile-actions mt-5">
        <h2>Действия</h2>
        <hr />
        <div class="col-md-12">  <!-- Убрал лишний row -->
            <a asp-page="/Users/Calendar" asp-route-performerId="@Model.Users.IdUser" class="btn btn-lg btn-block mb-2" style="background-color: #d9edf7; color: #31708f; padding: 20px; font-size: 1.25rem;">Перейти к календарю</a>
            <dt></dt>
            @if (User.IsInRole("user") || User.IsInRole("admin"))
            {
                <a asp-page="./Edit" asp-route-id="@Model.Users.IdUser" class="btn btn-lg btn-outline-secondary btn-block mb-2">Редактировать данные</a>
            }
            <dt></dt>
            @if (User.IsInRole("user"))
            {
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-lg btn-outline-secondary btn-block mb-2">Изменить email или пароль</a>
            }
            <dt></dt>
            @if (User.IsInRole("user") || User.IsInRole("admin"))
            {
                <a asp-page="./Delete" asp-route-id="@Model.Users.IdUser" class="btn btn-lg btn-outline-danger btn-block mb-2">Удалить профиль</a>
            }
        </div>
    </div>
</div>