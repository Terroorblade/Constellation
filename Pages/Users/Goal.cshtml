<div class="background"></div>

<div class="container mt-4">
    <div class="header-buttons">
        <!-- Кнопка Назад -->
        <a asp-page="/Users/Details" class="btn back">Назад в личный кабинет</a>
        <!-- Кнопка Добавить цель -->
        <button class="btn addgoal" id="openAddGoalModalButton">Добавить цель</button>
    </div>
    <h2 class="text-center">Мои Цели</h2>
  <hr />
    <!-- Разделяем страницу на 2 колонки -->
    <div class="row">
        <div class="content-container">
        <div class="col-md-6 column-left">
            <h3>Не выполнено</h3>
            <ul id="goalListIncomplete" class="list-group mb-3">
                <!-- Цели с не выполненным статусом будут добавлены сюда -->
            </ul>
        </div>
        <div class="col-md-6 column-right">
            <h3>Выполнено</h3>
            <ul id="goalListCompleted" class="list-group mb-3">
                <!-- Цели с выполненным статусом будут добавлены сюда -->
            </ul>
        </div>
        </div>
    </div>
</div>

<!-- Модальное окно для создания привычки -->
<div class="modal fade" id="goalDetailsModal" tabindex="-1" aria-labelledby="goalDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="goalDetailsModalLabel">Детали цели</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="goalDetails">
                    <!-- Здесь будут отображаться данные цели -->
                </div>
                <button class="btn btn-primary mt-3" id="createHabitButton">Сформировать привычку</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>


<!-- Модальное окно для добавления цели -->
<div class="modal fade" id="goalModal" tabindex="-1" aria-labelledby="goalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="goalModalLabel">Добавить цель</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <form id="addGoalForm">
                    <div class="mb-3">
                        <label for="goalTitle" class="form-label modal-title">Название цели</label>
                        <input type="text" class="form-control" id="goalTitle" required />
                    </div>
                    <div class="mb-3">
    <label for="goalSphere" class="form-label modal-title">Сфера жизни</label>
    <select class="form-control" id="goalSphere">
        <option value="1">Саморазвитие</option>
        <option value="2">Здоровье</option>
        <option value="3">Отдых</option>
        <option value="4">Окружение</option>
        <option value="5">Любовь</option>
        <option value="6">Карьера</option>
        <option value="7">Финансы</option>
        <option value="8">Духовность</option>
    </select>
</div>

                    <div class="mb-3">
                        <label for="goalDescription" class="form-label modal-title">Описание</label>
                        <textarea class="form-control" id="goalDescription" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="goalDeadline" class="form-label modal-title">Дедлайн</label>
                        <input type="date" class="form-control" id="goalDeadline" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary " data-bs-dismiss="modal">Закрыть</button>
                <button type="button" class="btn btn-primary" id="saveGoalButton">Сохранить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
    // Функция для загрузки целей
    function loadGoals() {
        $('#goalListIncomplete').empty();
        $('#goalListCompleted').empty();
        
        $.get('/Goals/GetGoals', function (data) {
            data.forEach(goal => {
                const isChecked = goal.status ? "checked" : "";
                const goalHtml = `
                    <li class="list-group-item ${goal.status ? 'bg-violet' : 'bg-blue'} goal-widget" data-goal-id="${goal.id}">
                        <strong>${goal.title}</strong><br>
                        @* <strong>Описание:</strong> ${goal.description || 'Нет описания'}<br> *@
                        <strong>Дедлайн:</strong> ${goal.end || 'Не указан'}<br>
                        <input type="checkbox" class="status-checkbox" data-goal-id="${goal.id}" ${isChecked}>
                        <label>Выполнено</label>
                        <button class="btn btn-danger btn-sm delete-goal-button" data-goal-id="${goal.id}" style="float: right;">Удалить</button>
                    </li>
                `;
                
                if (goal.status) {
                    // Если цель выполнена, добавляем в колонку "Выполнено"
                    $('#goalListCompleted').append(goalHtml);
                } else {
                    // Если цель не выполнена, добавляем в колонку "Не выполнено"
                    $('#goalListIncomplete').append(goalHtml);
                }
            });
        });
    }

    // Загрузка целей при загрузке страницы
    loadGoals();

    // Открытие модального окна для добавления цели
    $('#openAddGoalModalButton').click(function () {
        $('#goalTitle').val('');
        $('#goalDescription').val('');
        $('#goalDeadline').val('');
        $('#goalModal').modal('show');
    });

    // Сохранение цели
    $('#saveGoalButton').click(function () {
        const title = $('#goalTitle').val();
        const description = $('#goalDescription').val();
        const deadline = $('#goalDeadline').val();
        const sphere = $('#goalSphere').val(); 

        if (!title) {
            alert('Название цели обязательно.');
            return;
        }

        const goalData = {
            Name: title,
            Description: description,
            Deadline: deadline,
            GoalSphere: parseInt(sphere)
        };

        $.ajax({
            url: '/Goals/AddGoal',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(goalData),
            success: function () {
                alert('Цель добавлена успешно!');
                $('#goalModal').modal('hide');
                loadGoals(); // Обновляем список целей
            },
            error: function () {
                alert('Произошла ошибка при добавлении цели.');
            }
        });
    });

    // Удаление цели
    $(document).on('click', '.delete-goal-button', function () {
        const goalId = $(this).data('goal-id');
        if (confirm('Вы уверены, что хотите удалить эту цель?')) {
            $.ajax({
                url: '/Goals/DeleteGoal',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(goalId),
                success: function () {
                    alert('Цель удалена успешно!');
                    loadGoals(); // Обновляем список целей
                },
                error: function () {
                    alert('Произошла ошибка при удалении цели.');
                }
            });
        }
    });

    // Обновление статуса цели
    $(document).on('change', '.status-checkbox', function () {
        const goalId = $(this).data('goal-id');
        const status = $(this).is(':checked');

        $.post('/Goals/UpdateGoalStatus', { goalId, status })
            .done(() => {
                alert('Статус обновлен!');
                loadGoals(); // Обновляем цели после изменения статуса
            })
            .fail(() => alert('Ошибка обновления статуса.'));
    });
});

// Открытие модального окна для просмотра цели
$(document).on('click', '.goal-widget', function (event) {
    if (event.target.classList.contains('status-checkbox')) {
            return; // Выходим, если клик был по чекбоксу
        }

    const goalId = $(this).data('goal-id');

    $.get(`/Goals/GetGoalDetails/${goalId}`, function (data) {

   const sphereNames = {
            1: "Саморазвитие",
            2: "Здоровье",
            3: "Отдых",
            4: "Окружение",
            5: "Любовь",
            6: "Карьера",
            7: "Финансы",
            8: "Духовность"
        };
 const sphereName = sphereNames[data.sphere] || "Неизвестная сфера";

        $('#goalDetails').html(`
            <p><strong>Название:</strong> ${data.name}</p>
            <p><strong>Описание:</strong> ${data.description || 'Нет описания'}</p>
            <p><strong>Дедлайн:</strong> ${data.deadline || 'Не указан'}</p>
            <p><strong>Сфера жизни:</strong> ${sphereName}</p>
            <p><strong>Статус:</strong> ${data.status ? 'Выполнено' : 'Не выполнено'}</p>
            
        `);

        // Привязываем ID цели к кнопке "Сформировать привычку"
        $('#createHabitButton').data('goal-id', goalId);

        // Показываем модальное окно
        $('#goalDetailsModal').modal('show');
        
    }).fail(function () {
        alert('Не удалось загрузить данные цели.');
    });
});


// Обработчик для кнопки "Сформировать привычку"
$('#createHabitButton').click(function () {
  const goalId = $('#createHabitButton').data('goal-id');

    $.post(`/Goals/CreateHabitForGoal`, { goalId: goalId })
        .done(function () {
            alert('Привычка успешно создана и добавлена в расписание!');
            $('#goalModal').modal('hide');
            $('#calendar').fullCalendar('refetchEvents');
        })
        .fail(function () {
            alert('Ошибка при создании привычки.');
        });
});


    </script>
}
