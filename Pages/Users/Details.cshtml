@page
@model WebApplication1.Pages.Users.DetailsModel

@{
    ViewData["Title"] = "ЛК";
}

<style>
.button-container {
    display: flex;
    justify-content: space-between;  /* Равномерное распределение колонок */
    align-items: flex-start;  /* Выравнивание по верхнему краю */
    text-align: center;  /* Центрирование текста внутри колонок */
    gap: 70px; /* Отступы между колонками */
    margin-top: 20px;
    position: relative;
}

/* Колонки */
.button-column {
    display: flex;
    flex-direction: column;  /* Оставляем элементы внутри колонки вертикально */
    align-items: center;  /* Центрируем элементы по горизонтали */
    position: relative;  /* Для псевдоэлемента */
    @* padding: 0 15px;  /* Добавляем немного отступа по бокам */ *@
}

/* Горизонтальное разделение между колонками (сверху) */
.button-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #ccc;  /* Цвет разделителя */
}

/* Стили для текста (подписи) */
.button-label {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 10px;
}

/* Стили для кнопок */
.test-btn, .results-btn ,.goals-buttons {
    margin-top: 10px; /* Добавляем отступ между кнопками */
}

/* Стили для блока с кнопками теста и результатами */
.test-buttons,.goals-buttons {
    display: flex;
    flex-direction: column; 
    gap: 10px; /* Расстояние между кнопками */
    align-items: center; /* Центрируем кнопки */
}

/* Стили для кнопок */
.calendar-btn, .goals-btn, .test-btn, .results-btn {
    padding: 20px 45px; /* Увеличиваем размер кнопок */
    font-size: 18px; /* Увеличиваем размер текста */
    border-radius: 5px;
    text-decoration: none;
    cursor: pointer;
    color: rgb(255, 255, 255);
    border: none;
    transition: background-color 0.3s ease;
}

/* Цвета кнопок */
.calendar-btn {
    background-color: #bb52c1f4; 
}

.goals-btn {
    background-color: #d767a6f3;
}

.test-btn {
    background-color: #5f6bebe9; 
}

.results-btn {
    background-color: #725bccf2; 
}

/* Наведение на кнопки */
.calendar-btn:hover {
    background-color: #7c3fedf0;
}

.goals-btn:hover {
    background-color: #f52eeef0;
}

.test-btn:hover {
    background-color: #459bd5e8;
}

.results-btn:hover {
    background-color: #886cf9e8;
}
body{
            color:aliceblue;
            font-family: Georgia, serif;
        }
        .goals-label {
    margin-left: 50px; /* Добавляет отступ слева */
}
       .calendar-label {
    margin-left: 30px; /* Добавляет отступ слева */
}
.set-btn {
    background-color: #5d64af; 
    color:white;
}
 .auth-buttons {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .auth-buttons .btn {
        font-size: 1.5rem;
        padding: 20px 50px;
        border-radius: 10px;
        width: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .auth-buttons .btn:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }
    .modal-title{color:black;}
     .content-container {
        display: flex;
        @* flex-direction: column; *@
        @* flex-wrap: wrap; *@
        @* flex: 1 200px; *@
        @* align-items: center; /* Центрируем содержимое внутри контейнера */ *@
        @* text-align: center; /* Центрируем текст */ *@
        background-color: rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.381);
         max-width: 1200px;
         margin-left: 70px;
    }
</style>

<div class="background"></div>
<div class="profile-container text-center">
    <div class="profile-header">
        <h1>Личный кабинет</h1>
        <hr />
    </div>

    <div class="profile-info text-center">
        <div class="row">
            <div class="col-md-12">
                <h5 class="mb-3">Пользователь: @Html.DisplayFor(model => model.Users.Username)</h5>
                <!-- Кнопка для вызова модального окна -->
                <button type="button" class="btn btn-sm btn-outline-primary set-btn" data-bs-toggle="modal" data-bs-target="#accountSettingsModal">
                    Настройки аккаунта
                </button>
            </div>
        </div>
    </div>

    <!-- Модальное окно "Настройки аккаунта" -->
    <div class="modal fade" id="accountSettingsModal" tabindex="-1" aria-labelledby="accountSettingsModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title " id="accountSettingsModalLabel">Настройки аккаунта</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    @if (User.IsInRole("user"))
                    {
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" 
                           class="btn btn-outline-secondary w-100 mb-2">Изменить email/пароль</a>
                    }
                    @if (User.IsInRole("user") || User.IsInRole("admin"))
                    {
                        <a asp-page="./Edit" asp-route-id="@Model.Users.IdUser" 
                           class="btn btn-outline-secondary w-100 mb-2">Редактировать данные</a>
                        <a asp-page="./Delete" asp-route-id="@Model.Users.IdUser" 
                           class="btn btn-outline-danger w-100">Удалить профиль</a>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="profile-actions mt-5 text-center">
    <div class="button-container content-container">
        <!-- Первая колонка (Календарь) -->
        <div class="button-column">
            <span class="button-label calendar-label">Календарь</span>
            <hr/>
            <a asp-page="/Users/Calendar" asp-route-id="@Model.Users.IdUser" class="calendar-btn calendar-label">
                Перейти к календарю
            </a>
        </div>

        <!-- Вторая колонка (Цели) -->
        <div class="button-column">
            <span class="button-label goals-label" >Цели и привычки</span>
              
               <div class="goals-buttons">
            <a asp-page="/Users/Goal" asp-route-id="@Model.Users.IdUser" class="goals-btn goals-label">
                Мои цели
            </a>
             <a asp-page="/Users/Habit" asp-route-id="@Model.Users.IdUser" class="goals-btn goals-label">
                Мои привычки
            </a>
            </div>
        </div>

        <!-- Третья колонка (Тест на анализ сфер жизни) -->
        <div class="button-column">
            <span class="button-label">Тест</span>
            <div class="test-buttons">
                <a asp-page="/UserSphereSatisfaction/Test" class="test-btn">
                    Пройти тест на анализ сфер жизни
                </a>
                <a asp-page="/UserSphereSatisfaction/TestResults" asp-route-userId="@Model.Users.IdUser" class="test-btn">
                    Просмотреть результаты теста
                </a>
            </div>
        </div>
    </div>
</div>
