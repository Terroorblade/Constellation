@page
@model WebApplication1.Pages.TestModel
@{
    ViewData["Title"] = "Анализ сфер жизни";
}
<style>
    .content-container {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.381);
        max-width: 1200px;
        margin: 50px auto; /* Центрируем контейнер на странице */
    }

    .row {
        display: flex;
        justify-content: space-between; /* Разделяем пространство между колонками */
    }

    .col-md-6 {
        width: 48%; /* Каждая колонка занимает 48% ширины */
        padding: 10px;
        text-align: center;
    }

    h2,h5{
        color: aliceblue;
        font-family: Georgia, serif;
        text-align: center;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: center; 
        display: flex;
        flex-direction: column;
    }

    .list-group-item {
        width: 100%;
        margin-bottom: 15px; /* Отступ между элементами */
        text-align: center;
    }

    .textcol {
        font-size: 22px;
        color: aliceblue;
        font-family: Georgia, serif;
    }

    .sat-level {
        border-radius: 15px;
        max-width: 250px;
         text-align: center;
         margin: 0 auto; 
    }

    .save {
        margin-top: 20px;
        display: block; /* Делаем кнопку блочным элементом */
        margin-left: auto;
        margin-right: auto;
         padding: 15px 30px; /* Увеличиваем размер кнопок */
    font-size: 18px; /* Увеличиваем размер текста */
    border-radius: 5px;
     transition: background-color 0.3s ease;
       background-color: #682ae3f4; 
       color:aliceblue;
    }
    .save:hover{background-color: #885ce1f4;}
      .back {color: #ffffff !important;
        background-color: rgb(110, 96, 165);
         padding: 15px 25px; /* Увеличиваем размер кнопок */
    font-size: 16px; 
        }
</style>

<h2>Анализ сфер жизни</h2>
<h5>Оцените ваш уровень удовлетворенности каждой из сфер жизни по шкале 0 до 10</h5>
<div class="content-container">
    <form method="post">
        <!-- Разделяем страницу на 2 колонки -->
        <div class="row">
            <div class="col-md-6 column-left">
                @foreach (var sphere in Model.Spheres.Take(4)) {
                    <div class="form-group list-group-item">
                        <label asp-for="SphereSatisfactions[@sphere.SphereId].SatisfactionLevel" class="textcol">
                            @sphere.Name
                        </label>
                        <input asp-for="SphereSatisfactions[@sphere.SphereId].SatisfactionLevel" type="number" min="0" max="10" class="form-control sat-level" required />
                        <span asp-validation-for="SphereSatisfactions[@sphere.SphereId].SatisfactionLevel" class="text-danger"></span>
                    </div>
                }
            </div>

            <div class="col-md-6 column-right">
                @foreach (var sphere in Model.Spheres.Skip(4)) {
                    <div class="form-group list-group-item">
                        <label asp-for="SphereSatisfactions[@sphere.SphereId].SatisfactionLevel" class="textcol">
                            @sphere.Name
                        </label>
                        <input asp-for="SphereSatisfactions[@sphere.SphereId].SatisfactionLevel" type="number" min="0" max="10" class="form-control sat-level" required />
                        <span asp-validation-for="SphereSatisfactions[@sphere.SphereId].SatisfactionLevel" class="text-danger"></span>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn save">Сохранить</button>
                <a asp-page="/Users/Details" class="btn back">Назад в личный кабинет</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
